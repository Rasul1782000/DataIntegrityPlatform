# Data Integrity & Security Monitoring Platform - backend configuration
# Copy this file to `.env` and adjust the values. Every variable below is
# prefixed with APP_ (SMTP_* and NOTIFICATIONS_RECIPIENT excepted).

# --- Security ---
# REQUIRED. Random value, at least 32 characters.
APP_SECRET_KEY=change-me-to-a-random-secret-of-32-chars-minimum

# development | test | production
APP_ENVIRONMENT=development

# --- Database ---
# Optional. SQLite under backend/storage is used when omitted.
# APP_DATABASE_URL=sqlite:///./storage/platform.db

# --- CORS ---
# JSON array. Origins allowed to call the GraphQL API from a browser.
# Default: http://localhost:4200 and http://127.0.0.1:4200
# APP_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# --- Tokens ---
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=7

# --- Bootstrap administrator ---
# Created only when the database has no users. All three must be set together;
# password must be at least 14 characters. Remove after first startup.
# APP_BOOTSTRAP_ADMIN_USERNAME=admin
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=Change-Me-Now-2024!

# --- Email notifications (SMTP) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=app-password-here
# NOTIFICATIONS_RECIPIENT=security-team@example.com
